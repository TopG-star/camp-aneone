# ─────────────────────────────────────────────────────────────
# .env.template — Production / staging secrets
# Copy to .env, fill in values, NEVER commit .env
# See docs/SETUP_ENV.md for instructions.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
PUBLIC_URL=https://your-domain.com

# ── Auth ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com
ALLOWED_EMAILS=
API_TOKEN=

# ── OAuth Token Encryption (REQUIRED in production) ──────────
# Generate: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Anthropic LLM ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── AI data boundary (ADR-012) ───────────────────────────────
# at least 32 characters; required whenever a model provider key is set; generate with `openssl rand -base64 32`
MODEL_AUDIT_HMAC_KEY=
# Bump when you rotate MODEL_AUDIT_HMAC_KEY
MODEL_AUDIT_HMAC_KEY_VERSION=1
# Emergency override: suspend a provider or lower its limit, e.g. deepseek:suspended,anthropic:D1
# MODEL_PROVIDER_OVERRIDES=

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=./data/oneon.db
# The control database (identities, pharmacy registrations, grants) and the folder of per-pharmacy files. Keep both on the data volume.
CONTROL_DATABASE_PATH=./data/control.db
TENANT_DATA_DIR=./data/tenants
# Encrypted backups are written here (spec 8.7). Sync this folder off-site and prune it yourself; see docs/DEPLOY.md.
BACKUP_DIR=./data/backups
# base64 of 32 bytes (openssl rand -base64 32). Required once any pharmacy is registered; keep a copy off the VPS.
# BACKUP_ENCRYPTION_KEY=

# ── Pharmacies (ImpressoRx) ──────────────────────────────────
# Both are base64 of 32 bytes: openssl rand -base64 32. Enrolling a pharmacy is refused (HTTP 503) until both are set.
# Losing either one makes every pharmacy registration (signing key) or every delegation grant (grant key) unusable,
# and nothing can decrypt them again: keep a copy of each somewhere other than the VPS, like BACKUP_ENCRYPTION_KEY.
# Seals Oneon's private signing key for each pharmacy.
# ONEON_SIGNING_KEY_MASTER_KEY=
# Seals the delegation grants ImpressoRx issues at each hand-off. Without it every hand-off fails.
# ONEON_GRANT_MASTER_KEY=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ── Power Automate Webhooks ──────────────────────────────────
PA_OUTLOOK_WEBHOOK_SECRET=
PA_TEAMS_WEBHOOK_SECRET=

# ── Cloudflare Tunnel ───────────────────────────────────────
# Quick Tunnel (free, no domain needed): leave blank — URL auto-assigned
# Named Tunnel (custom domain): uncomment and set token
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Web Push (VAPID) ────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ── Feature Flags ────────────────────────────────────────────
# Per-action approval settings live in Settings → Actions.
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_CHAT=true
FEATURE_BACKGROUND_LOOP=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
